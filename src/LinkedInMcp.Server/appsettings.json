{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "LinkedIn": {
    "DefaultApiVersion": "202602",
    "DefaultScopes": [ "openid", "profile", "email" ],
    "Features": {
      "UserInfo": true,
      "MemberPosting": false,
      "OrganizationPosting": false,
      "AdsManagement": false,
      "AdsReporting": false,
      "Webhooks": true
    }
  },
  "AllowedHosts": "*"
}
